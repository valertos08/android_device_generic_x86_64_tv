            <name>IComposer</name>
            <instance>drmfb</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>android.hardware.graphics.composer</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IComposer</name>
            <instance>default_clone</instance>        
