cc_defaults {
    name: "android.hardware.boot-service.x86_common",
    relative_install_path: "hw",
    defaults: ["libboot_control_defaults"],
    vintf_fragments: ["android.hardware.boot-service.x86.xml"],
    srcs: [
        "main.cpp",
        "BootControl.cpp",
        "x86_boot_control.cpp",
    ],
    cppflags: ["-Wno-unused-variable"],
    cflags: ["-Wno-unused-variable"],
    header_libs: ["generated_kernel_headers"],
}

cc_binary {
    name: "android.hardware.boot-service.x86",
    defaults: ["android.hardware.boot-service.x86_common"],
    vendor: true,
    init_rc: ["android.hardware.boot-service.x86.rc"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
        "libboot_control",
        "libfstab",
    ],
}

cc_binary {
    name: "android.hardware.boot-service.x86_recovery",
    defaults: ["android.hardware.boot-service.x86_common"],
    recovery: true,
    init_rc: ["android.hardware.boot-service.x86_recovery.rc"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
    ],
    static_libs: [
        "libboot_control",
        "libfstab",
    ],
}
